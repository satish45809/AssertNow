# Environment mode: development | production | test
NODE_ENV=development

# Port the Express server listens on
PORT=3000

# Logging level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Allowed CORS origins, comma-separated
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 32-byte encryption key for AES-256-GCM as a 64-character hex string
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# Temporary default organization ID (TODO(auth): real auth in Phase 6)
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001

# Salesforce API version to use across adapter integrations
SF_API_VERSION=60.0

# Optional test variables for scripts/testSalesforce.ts (never commit real secrets)
SF_TEST_LOGIN_URL=
SF_TEST_CLIENT_ID=
SF_TEST_CLIENT_SECRET=
