{
  "nodeModulesDir": "auto",
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-env --allow-write src/server.ts",
    "dev": "deno run --watch --allow-net --allow-read --allow-env --allow-write src/server.ts",
    "check": "deno check src/server.ts"
  },
  "imports": {
    "hono": "npm:hono@^4.6.14",
    "hono/cors": "npm:hono@^4.6.14/cors",
    "hono/logger": "npm:hono@^4.6.14/logger",
    "jsforce": "npm:jsforce@^3.6.14"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true
  }
}

